#. mt: deepl
#, fuzzy
msgid "What&#8217;s new?"
msgstr "¿Qué hay de nuevo?"

#, fuzzy
msgid "Today, we released Quarkus 1.8.1.Final with some bugfixes and documentation improvements."
msgstr "Hoy hemos lanzado Quarkus 1.8.1.Final con algunas correcciones de errores y mejoras en la documentación."

#, fuzzy
msgid "We also introduced a new RESTEasy Multipart extension to fix an recurring encoding issues with multipart."
msgstr "También hemos introducido una nueva extensión RESTEasy Multipart para solucionar un problema recurrente de codificación con multipartes."

#, fuzzy
msgid "It is a safe upgrade for everyone using 1.8.0.Final."
msgstr "Es una actualización segura para todos los que utilizan la versión 1.8.0.Final."

#, fuzzy
msgid "This release is a maintenance release that fixes various bugs found in 1.8.0.Final and provides some documentation updates."
msgstr "Esta versión es una versión de mantenimiento que corrige varios errores encontrados en 1.8.0.Final y proporciona algunas actualizaciones de la documentación."

#, fuzzy
msgid "You can get https://github.com/quarkusio/quarkus/releases/tag/1.8.1.Final[the full changelog of 1.8.1.Final on GitHub]."
msgstr "Puedes obtener  link:https://github.com/quarkusio/quarkus/releases/tag/1.8.1.Final[el registro de cambios completo de 1.8.1.Final en GitHub]."

#, fuzzy
msgid "RESTEasy Multipart"
msgstr "RESTEasy Multipart"

#, fuzzy
msgid "The default encoding for multipart requests in RESTEasy is US-ASCII which is not very convenient in 2020."
msgstr "La codificación por defecto de las solicitudes multiparte en RESTEasy es US-ASCII, lo que no es muy conveniente en 2020."

#, fuzzy
msgid ""
"Thanks to the `quarkus-resteasy-multipart` extension, the default encoding is now UTF-8 and it can be configured if needed.\n"
"If working with multipart, make sure you use this extension."
msgstr "Gracias a la extensión `quarkus-resteasy-multipart` , la codificación por defecto es ahora UTF-8 y puede configurarse si es necesario. Si trabaja con multipart, asegúrese de utilizar esta extensión."

#, fuzzy
msgid "More on this in the link:/guides/rest-json#multipart-support[Writing JSON REST Services guide]."
msgstr "Más información sobre esto en la  link:/guides/rest-json#multipart-support[guía Writing JSON REST Services]."

msgid "Come Join Us"
msgstr "Únete a nosotros"

msgid "We value your feedback a lot so please report bugs, ask for improvements... Let's build something great together!"
msgstr "Valoramos mucho tus comentarios, así que por favor reporta errores, solicita mejoras... ¡Construyamos algo grandioso juntos!"

msgid "If you are a Quarkus user or just curious, don't be shy and join our welcoming community:"
msgstr "Si eres un usuario de Quarkus o simplemente tienes curiosidad, no seas tímido y únete a nuestra acogedora comunidad:"

msgid "provide feedback on https://github.com/quarkusio/quarkus/issues[GitHub];"
msgstr "proporcionar retroalimentación en https://github.com/quarkusio/quarkus/issues[GitHub];"

msgid "craft some code and https://github.com/quarkusio/quarkus/pulls[push a PR];"
msgstr "escribir algo de código y enviar https://github.com/quarkusio/quarkus/pulls[push a PR];"

msgid "discuss with us on https://quarkusio.zulipchat.com/[Zulip] and on the https://groups.google.com/d/forum/quarkus-dev[mailing list];"
msgstr "comentar con nosotros en https://quarkusio.zulipchat.com/[Zulip] y en nuestra https://groups.google.com/d/forum/quarkus-dev[lista de correo];"

msgid "ask your questions on https://stackoverflow.com/questions/tagged/quarkus[Stack Overflow]."
msgstr "hacer tus preguntas en https://stackoverflow.com/questions/tagged/quarkus[Stack Overflow]."
