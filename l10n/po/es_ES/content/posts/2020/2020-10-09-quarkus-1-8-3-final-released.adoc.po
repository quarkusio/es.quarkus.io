#. mt: deepl
#, fuzzy
msgid "What&#8217;s new?"
msgstr "¿Qué hay de nuevo?"

#, fuzzy
msgid "Today, we released Quarkus 1.8.3.Final which contains a fix for an annoying regression and some other fixes."
msgstr "Hoy hemos publicado Quarkus 1.8.3.Final, que contiene una corrección de una molesta regresión y algunas otras correcciones."

#, fuzzy
msgid "It is a safe upgrade for everyone using Quarkus 1.8."
msgstr "Es una actualización segura para todos los que utilizan Quarkus 1.8."

#, fuzzy
msgid "This release is a maintenance release that fixes various bugs found in 1.8.2.Final and provides some documentation updates."
msgstr "Esta versión es una versión de mantenimiento que corrige varios errores encontrados en 1.8.2.Final y proporciona algunas actualizaciones de la documentación."

#, fuzzy
msgid "The main change we made is a downgrade of `slf4j-jboss-logging` motivated by a regression in `slf4j-jboss-logging`: https://github.com/quarkusio/quarkus/issues/12615 ."
msgstr "El principal cambio que hemos realizado es una rebaja de `slf4j-jboss-logging` motivada por una regresión en `slf4j-jboss-logging`:  https://github.com/quarkusio/quarkus/issues/12615 ."

#, fuzzy
msgid "You can get https://github.com/quarkusio/quarkus/releases/tag/1.8.3.Final[the full changelog of 1.8.3.Final on GitHub]."
msgstr "Puedes obtener  link:https://github.com/quarkusio/quarkus/releases/tag/1.8.3.Final[el registro de cambios completo de 1.8.3.Final en GitHub]."

msgid "Come Join Us"
msgstr "Únete a nosotros"

msgid "We value your feedback a lot so please report bugs, ask for improvements... Let's build something great together!"
msgstr "Valoramos mucho tus comentarios, así que por favor reporta errores, solicita mejoras... ¡Construyamos algo grandioso juntos!"

msgid "If you are a Quarkus user or just curious, don't be shy and join our welcoming community:"
msgstr "Si eres un usuario de Quarkus o simplemente tienes curiosidad, no seas tímido y únete a nuestra acogedora comunidad:"

msgid "provide feedback on https://github.com/quarkusio/quarkus/issues[GitHub];"
msgstr "proporcionar retroalimentación en https://github.com/quarkusio/quarkus/issues[GitHub];"

msgid "craft some code and https://github.com/quarkusio/quarkus/pulls[push a PR];"
msgstr "escribir algo de código y enviar https://github.com/quarkusio/quarkus/pulls[push a PR];"

msgid "discuss with us on https://quarkusio.zulipchat.com/[Zulip] and on the https://groups.google.com/d/forum/quarkus-dev[mailing list];"
msgstr "comentar con nosotros en https://quarkusio.zulipchat.com/[Zulip] y en nuestra https://groups.google.com/d/forum/quarkus-dev[lista de correo];"

msgid "ask your questions on https://stackoverflow.com/questions/tagged/quarkus[Stack Overflow]."
msgstr "hacer tus preguntas en https://stackoverflow.com/questions/tagged/quarkus[Stack Overflow]."
