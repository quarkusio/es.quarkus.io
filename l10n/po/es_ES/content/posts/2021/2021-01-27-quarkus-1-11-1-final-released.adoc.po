#. mt: deepl
#, fuzzy
msgid "What&#8217;s new?"
msgstr "¿Qué hay de nuevo?"

#, fuzzy
msgid "1.11.1.Final is a maintenance release fixing bugs and improving the documentation."
msgstr "1.11.1.Final es una versión de mantenimiento que corrige errores y mejora la documentación."

#, fuzzy
msgid ""
"Thanks to all the contributors who reported issues and provided reproducers:\n"
"it allowed us to make steady progress on fixing issues."
msgstr "Gracias a todos los colaboradores que informaron de los problemas y proporcionaron reproductores: eso nos permitió avanzar de forma constante en la solución de los problemas."

#, fuzzy
msgid ""
"Also a big thanks to all the contributors providing pull requests,\n"
"be they for the code or the documentation!"
msgstr "También un gran agradecimiento a todos los colaboradores que proporcionan pull requests, ¡ya sea para el código o para la documentación!"

#, fuzzy
msgid "1.11.1.Final is a safe upgrade for everyone using Quarkus 1.11."
msgstr "1.11.1.Final es una actualización segura para todos los que usan Quarkus 1.11."

#, fuzzy
msgid "If you are not using 1.11 already, please refer to the https://github.com/quarkusio/quarkus/wiki/Migration-Guide-1.11[1.11 migration guide]."
msgstr "Si no está utilizando ya la versión 1.11, consulte la  link:https://github.com/quarkusio/quarkus/wiki/Migration-Guide-1.11[guía de migración a la versión 1.11]."

#, fuzzy
msgid "GraalVM"
msgstr "GraalVM"

#, fuzzy
msgid "The recommended GraalVM version is now GraalVM 20.3.1."
msgstr "La versión recomendada de GraalVM es ahora GraalVM 20.3.1."

msgid "Full changelog"
msgstr "Registro completo de cambios"

#, fuzzy
msgid "You can get https://github.com/quarkusio/quarkus/releases/tag/1.11.1.Final[the full changelog of 1.11.1.Final on GitHub]."
