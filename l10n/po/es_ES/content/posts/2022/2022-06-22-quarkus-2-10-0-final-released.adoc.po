msgstr "link:/guides/security-openid-connect-client-reference[Guía de referencia del cliente OpenId Connect]"

#, fuzzy
msgid "link:/guides/podman[Using Podman with Quarkus]"
msgstr "link:/guides/podman[Uso de Podman con Quarkus]"

msgid "Full changelog"
msgstr "Registro completo de cambios"

#, fuzzy
msgid "You can get the full changelog of https://github.com/quarkusio/quarkus/releases/tag/2.10.0.CR1[2.10.0.CR1] and https://github.com/quarkusio/quarkus/releases/tag/2.10.0.Final[2.10.0.Final] on GitHub."
msgstr "Puedes obtener  link:https://github.com/quarkusio/quarkus/releases/tag/2.10.0.Final[el registro de cambios completo de 2.10.0.Final en GitHub]."

