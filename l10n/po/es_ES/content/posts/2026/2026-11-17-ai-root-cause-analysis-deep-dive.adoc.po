msgstr "`traceById`"

#. mt: deepl
#, fuzzy
msgid "Full trace data for a specific trace"
msgstr "Datos completos de un seguimiento concreto"

#. mt: deepl
#, fuzzy
msgid "`logsWithTraceId`"
msgstr "`registrosConIdDeRastreo`"

#. mt: deepl
#, fuzzy
msgid "Correlated Loki logs for a trace"
msgstr "Registros de Loki relacionados con una traza"

#. mt: deepl
