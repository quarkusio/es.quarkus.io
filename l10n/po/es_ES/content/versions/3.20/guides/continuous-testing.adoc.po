msgid "Continuous Testing"
msgstr "Pruebas continuas"

msgid "Learn how to use continuous testing in your Quarkus Application."
msgstr "Aprenda a utilizar las pruebas continuas en su aplicación Quarkus."

msgid "Prerequisites"
msgstr "Requisitos previos"

#, fuzzy
msgid "To complete this guide, you need:"
msgstr "Para completar esta guía, necesitas:"

#, fuzzy
msgid "Roughly 15 minutes"
msgstr "Aproximadamente 15 minutos"

#, fuzzy
msgid "An IDE"
msgstr "Un IDE"

#, fuzzy
msgid "JDK 17+ installed with `JAVA_HOME` configured appropriately"
msgstr "JDK 17+ instalado con `JAVA_HOME` configurado adecuadamente"

#, fuzzy
msgid "Apache Maven {maven-version}"
msgstr "Apache Maven {versión de Maven}"

