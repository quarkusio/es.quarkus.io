msgid "Extending configuration support"
msgstr ""

msgid "Custom <code>ConfigSource</code>"
msgstr ""

msgid ""
"It's possible to create a custom `ConfigSource` as specified in\n"
"link:https://github.com/eclipse/microprofile-config/blob/master/spec/src/"
"main/asciidoc/configsources.asciidoc#custom-configsources-via-"
"configsourceprovider[MicroProfile Config]."
msgstr ""

msgid ""
"With a Custom `ConfigSource` it is possible to read additional configuration "
"values and add them to the `Config`\n"
"instance in a defined ordinal. This allows overriding values from other "
"sources or falling back to other values."
msgstr ""

msgid ""
"A custom `ConfigSource` requires an implementation of `org.eclipse."
"microprofile.config.spi.ConfigSource` or\n"
"`org.eclipse.microprofile.config.spi.ConfigSourceProvider`. Each "
"implementation requires registration via\n"
"the https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/"
"ServiceLoader.html[ServiceLoader] mechanism, either in\n"
"`META-INF/services/org.eclipse.microprofile.config.spi.ConfigSource` or\n"
"`META-INF/services/org.eclipse.microprofile.config.spi.ConfigSourceProvider` "
"files."
msgstr ""

