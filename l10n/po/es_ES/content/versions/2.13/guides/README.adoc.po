msgid "Glossary"
msgstr "Glosario"

msgid ""
"This is a collection of preferred term in the documentation and website.\n"
"Please stay within these terms for consistency."
msgstr ""

msgid "Live coding:: for our `quarkus:dev` capability"
msgstr "Codificación en directo:: para nuestra capacidad `quarkus:dev`"

msgid "GraalVM native image:: preferred term for the VM creating native executable. No space."
msgstr "Imagen nativa de GraalVM:: término preferido para la VM que crea el ejecutable nativo. Sin espacio."

msgid "Substrate VM:: non-preferred. Exclude."
msgstr "Substrate VM:: no preferido. Excluir."

msgid "Native Executable:: the executable that is compiled to native 1s and 0s"
msgstr "Ejecutable nativo:: el ejecutable que se compila a 1s y 0s nativos"

msgid "Docker image:: for the actual `Dockerfile` definition and when the tool chain is involved"
msgstr "Imagen Docker:: para la definición real de `Dockerfile` y cuando se trata de la cadena de herramientas"

msgid "Container:: when we discuss Quarkus running in... containers"
msgstr "Contenedor:: cuando hablamos de Quarkus ejecutándose en... contenedores"

msgid "Supersonic Subatomic Java:: our tagline"
msgstr "Supersonic Subatomic Java:: nuestro lema"

msgid "Kubernetes Native Java:: our preferred tagline to say that we rock for containers"
msgstr "Kubernetes Native Java:: nuestro eslogan preferido para decir que somos lo máximo en contenedores"

msgid "Developer Joy:: for everything going from live reload to the opinionated layer to a single config file"
msgstr "Developer Joy:: para todo, desde la recarga en vivo hasta la capa de opinión, pasando por un único archivo de configuración"

msgid "Unify Imperative and Reactive:: imperative and reactive. 'Nuff said."
msgstr "Unify Imperative and Reactive:: imperativo y reactivo. No hay más que decir."

msgid "Best of breed frameworks and standards:: when we explain our stack"
msgstr "Best of breed frameworks and standards:: cuando explicamos nuestra pila"
