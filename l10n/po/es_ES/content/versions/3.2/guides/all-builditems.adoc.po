msgstr "link:https://github.com/quarkusio/quarkus/blob/main/core/deployment/src/main/java/io/quarkus/deployment/builditem/nativeimage/ExcludeConfigBuildItem.java[io.quarkus.deployment.builditem.nativeimage.ExcludeConfigBuildItem]"

