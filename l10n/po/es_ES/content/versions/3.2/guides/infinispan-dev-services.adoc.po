#, fuzzy
msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_INFINISPAN_CLIENT_DEVSERVICES_SHARED+++[]"
msgstr "Variable de entorno: env_var_with_copy_button:QUARKUS_INFINISPAN_CLIENT_DEVSERVICES_SHARED[]"

#. mt: deepl
