msgid ""
"[[quarkus-vertx-core_quarkus-vertx-growth-resistance]]`link:#quarkus-vertx-core_quarkus-vertx-growth-resistance[quarkus.vertx.growth-resistance]`\n"
"\n"
"\n"
"[.description]\n"
"--\n"
"The executor growth resistance. A resistance factor applied after the core pool is full; values applied here will cause that fraction of submissions to create new threads when no idle thread is available. A value of `0.0f` implies that threads beyond the core size should be created as aggressively as threads within it; a value of `1.0f` implies that threads beyond the core size should never be created.\n"
"\n"
"Environment variable: env_var_with_copy_button:+++QUARKUS_VERTX_GROWTH_RESISTANCE+++[]\n"
"--"
msgstr "`link:#quarkus-vertx-core_quarkus-vertx-growth-resistance[quarkus.vertx.resistencia-al-crecimiento]`"

#. mt: deepl
#, fuzzy
msgid "[[quarkus-vertx-core_quarkus-vertx-growth-resistance]]`link:#quarkus-vertx-core_quarkus-vertx-growth-resistance[quarkus.vertx.growth-resistance]`"
msgstr "`link:#quarkus-vertx-core_quarkus-vertx-growth-resistance[quarkus.vertx.resistencia-al-crecimiento]`"

#. mt: deepl
#, fuzzy
msgid "The executor growth resistance. A resistance factor applied after the core pool is full; values applied here will cause that fraction of submissions to create new threads when no idle thread is available. A value of `0.0f` implies that threads beyond the core size should be created as aggressively as threads within it; a value of `1.0f` implies that threads beyond the core size should never be created."
msgstr "La resistencia al crecimiento del ejecutor. Se trata de un factor de resistencia que se aplica una vez que el grupo central está lleno; los valores que se establezcan aquí harán que una fracción de las solicitudes cree nuevos subprocesos cuando no haya ningún subproceso inactivo disponible. Un valor de `0,0f` implica que los subprocesos que superen el tamaño del núcleo deben crearse con la misma intensidad que los subprocesos que se encuentran dentro de él; un valor de `1,0f` implica que nunca deben crearse subprocesos que superen el tamaño del núcleo."

#. mt: deepl
#, fuzzy
msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_VERTX_GROWTH_RESISTANCE+++[]"
msgstr "Variable de entorno: env_var_with_copy_button:QUARKUS_VERTX_GROWTH_RESISTANCE[]"

