msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_INFINISPAN_CLIENT_SASL_MECHANISM+++[]"
msgstr "Variable de entorno: env_var_with_copy_button:QUARKUS_INFINISPAN_CLIENT_SASL_MECHANISM[]"

#. mt: deepl
#, fuzzy
msgid "`+++DIGEST-SHA-512+++`"
msgstr "`DIGEST-SHA-512`"

