msgid ""
"[[quarkus-oidc_quarkus-oidc-authentication-error-path]] [.property-path]##link:#quarkus-oidc_quarkus-oidc-authentication-error-path[`+++quarkus.oidc.authentication.error-path+++`]##\n"
"config_property_copy_button:+++quarkus.oidc.authentication.error-path+++[]\n"
