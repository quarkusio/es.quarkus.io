#. type: Content of: <div><div><div><h2>
#: templates/partials/homepage-imperative_and_reactive-band.html:4
msgid "Unifies Imperative and Reactive"
msgstr "Unifica lo imperativo y lo reactivo"

#. type: Content of: <div><div><div><p>
#: templates/partials/homepage-imperative_and_reactive-band.html:7
#, fuzzy
msgid "Combine both the familiar imperative code and the reactive style when developing applications.  <a href=\"/continuum\">Learn more</a>."
msgstr "Combine tanto el código imperativo conocido como el estilo reactivo al desarrollar aplicaciones. <a href=\"/vision/continuum\">Aprenda más</a>."

#. type: Content of: <div><div><div><div><div><div>
#: templates/partials/homepage-imperative_and_reactive-band.html:13
msgid "Imperative"
msgstr "Imperativo"

#. type: Content of: <div><div><div><div><div><div><pre>
#: templates/partials/homepage-imperative_and_reactive-band.html:15
#, no-wrap
msgid ""
"<code>@Inject\n"
"SayService say;\n"
"\n"
"@GET\n"
"@Produces(MediaType.TEXT_PLAIN)\n"
"public String hello() {\n"
"    return say.hello();\n"
"}</code>"
msgstr ""

#. type: Content of: <div><div><div><div><div><div>
#: templates/partials/homepage-imperative_and_reactive-band.html:26
msgid "Reactive"
msgstr "Reactivo"

#. type: Content of: <div><div><div><div><div><div><pre>
#: templates/partials/homepage-imperative_and_reactive-band.html:28
#, no-wrap
msgid ""
"<code>@Channel(\"kafka\") Multi&lt;String&gt; events;\n"
"\n"
"@GET\n"
"@Produces(MediaType.SERVER_SENT_EVENTS)\n"
"public Multi&lt;String&gt; events() {\n"
"    return events;\n"
"}</code>"
msgstr ""
